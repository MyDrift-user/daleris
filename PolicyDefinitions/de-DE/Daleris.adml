  <displayName>Daleris</displayName>
  <description>Daleris</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_ANY">Daleris unter Windows</string>
      <string id="Daleris">Daleris</string>
      <string id="CatFixed">Feste Einstellungen (nicht durch Benutzer änderbar)</string>
      <string id="CatRecommended">Standardeinstellungen (durch Benutzer änderbar)</string>
      <string id="ExplainFixed">Dieser Wert ist fest: Er gilt für alle Betroffenen und ist in der App ausgegraut. Ist er nicht konfiguriert, entscheiden die Benutzer selbst.</string>
      <string id="ExplainRecommended">Dieser Wert ist ein Standard: Er gilt, bis ein Benutzer in der App einen eigenen Wert wählt, und kann jederzeit geändert werden.</string>
      <string id="ShowHiddenItems">Versteckte und Systemelemente anzeigen</string>
