<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Daleris</displayName>
  <description>Daleris</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_ANY">Daleris on Windows</string>
      <string id="Daleris">Daleris</string>
      <string id="CatFixed">Fixed settings (cannot be changed by users)</string>
      <string id="CatRecommended">Default settings (users can change them)</string>
      <string id="ExplainFixed">This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="ExplainRecommended">This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="ShowHiddenItems">Show hidden and system items</string>
      <string id="HideDotfiles">Hide dotfiles and dotfolders (Windows)</string>
      <string id="ExplorerColours">Explorer's colours, following Windows (Windows)</string>
      <string id="ExplorerLines">Explorer's lines between the panes and around the tab in front (Windows)</string>
      <string id="ExplorerMica">Mica behind the tab bar (Windows 11)</string>
      <string id="ExplorerMicaBar">With Mica, a little of it through the tab in front and the address bar (Windows 11)</string>
      <string id="OpenNewDrives">Open a tab for a drive when it's connected (Windows)</string>
      <string id="StartNewWindow">Starting Daleris again opens a new window (Windows)</string>
      <string id="ShareTransferNotes">Show others on network shares what you copy, move, delete and have open</string>
      <string id="DefaultSort">Default sort order</string>
      <string id="DefaultSortAscending">Default sort runs from A, oldest or smallest</string>
      <string id="FoldersFirst">Keep folders above files by default</string>
      <string id="DownloadsNewestFirst">Show Downloads newest first, with folders mixed in</string>
      <string id="Sort_name">Name</string>
      <string id="Sort_modified">Date modified</string>
      <string id="Sort_created">Date created</string>
      <string id="Sort_type">Type</string>
      <string id="Sort_extension">Extension</string>
      <string id="Sort_size">Size</string>
      <string id="ShowPreviewPane">Show the preview pane</string>
      <string id="ShowFileExtensions">Show file name extensions</string>
      <string id="CustomTitleBar">Use the Daleris title bar</string>
      <string id="TitleBarLogo">Show the logo in the title bar</string>
      <string id="TitleBarName">Show the app name in the title bar</string>
      <string id="TitleBarSettingsButton">Show the settings button</string>
      <string id="TitleBarBrandSettings">The logo and name open Settings, in place of the settings button</string>
      <string id="ReopenTabs">Reopen tabs at startup</string>
      <string id="WindowsPropertiesDialog">Use the Windows Properties dialog</string>
      <string id="FolderSizes">Show folder sizes</string>
      <string id="SearchSubfolders">Search subfolders</string>
      <string id="SearchRegex">Treat searches as regular expressions</string>
      <string id="SearchHideSubfolders">Hide the subfolders switch in the search box</string>
      <string id="SearchHideRegex">Hide the regular expression switch in the search box</string>
      <string id="SearchHideHelp">Hide the help button (?) in the search box</string>
      <string id="CatSearch">Search</string>
      <string id="SearchSkipAppData">Never find app data in search</string>
      <string id="SearchSkipAppDataExplain_ExplainFixed">Search leaves out folders named AppData and everything in them. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="SearchSkipAppDataExplain_ExplainRecommended">Search leaves out folders named AppData and everything in them. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="SearchSkipWindows">Never find Windows and installed programs in search</string>
      <string id="SearchSkipWindowsExplain_ExplainFixed">Search leaves out folders named Windows, Program Files, Program Files (x86), ProgramData, $Recycle.Bin, System Volume Information, $WinREAgent and Recovery, and everything in them. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="SearchSkipWindowsExplain_ExplainRecommended">Search leaves out folders named Windows, Program Files, Program Files (x86), ProgramData, $Recycle.Bin, System Volume Information, $WinREAgent and Recovery, and everything in them. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="SearchSkipDeveloperFiles">Never find developer clutter in search</string>
      <string id="SearchSkipDeveloperFilesExplain_ExplainFixed">Search leaves out folders named node_modules, .git, .svn, target, __pycache__, .cache, .cargo, .rustup, .npm, .gradle, .venv and venv, and everything in them. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="SearchSkipDeveloperFilesExplain_ExplainRecommended">Search leaves out folders named node_modules, .git, .svn, target, __pycache__, .cache, .cargo, .rustup, .npm, .gradle, .venv and venv, and everything in them. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="SearchSkipCloudFolders">Never find cloud folders in search</string>
      <string id="SearchSkipCloudFoldersExplain_ExplainFixed">Search leaves out folders named OneDrive, Dropbox, Google Drive and iCloudDrive, and everything in them. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="SearchSkipCloudFoldersExplain_ExplainRecommended">Search leaves out folders named OneDrive, Dropbox, Google Drive and iCloudDrive, and everything in them. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="SearchSkipTempFiles">Never find temporary and log files in search</string>
      <string id="SearchSkipTempFilesExplain_ExplainFixed">Search leaves out files ending in .tmp, .temp, .log, .bak and .dmp. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="SearchSkipTempFilesExplain_ExplainRecommended">Search leaves out files ending in .tmp, .temp, .log, .bak and .dmp. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="SearchSkipProgramParts">Never find program parts in search</string>
      <string id="SearchSkipProgramPartsExplain_ExplainFixed">Search leaves out files ending in .dll, .sys, .mui, .cat, .pdb, .obj and .lib. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="SearchSkipProgramPartsExplain_ExplainRecommended">Search leaves out files ending in .dll, .sys, .mui, .cat, .pdb, .obj and .lib. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="SearchSkipHidden">Never find hidden items in search</string>
      <string id="SearchSkipHiddenExplain_ExplainFixed">Search leaves out hidden files and folders, and everything in hidden folders, even when people show hidden items. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="SearchSkipHiddenExplain_ExplainRecommended">Search leaves out hidden files and folders, and everything in hidden folders, even when people show hidden items. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="SearchSkipSystem">Never find system files in search</string>
      <string id="SearchSkipSystemExplain_ExplainFixed">Search leaves out files and folders that Windows marks as system files, such as desktop.ini, and everything in such folders. On unless set otherwise. Windows only. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="SearchSkipSystemExplain_ExplainRecommended">Search leaves out files and folders that Windows marks as system files, such as desktop.ini, and everything in such folders. On unless set otherwise. Windows only. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="SearchSkipFolders">Never find these folders in search</string>
      <string id="SearchSkipFoldersExplain_ExplainFixed">Folders that search leaves out, with everything in them, one per line. Environment variables such as %USERPROFILE% work. This list is fixed: it is added to people's own rules and applies to everyone it reaches. People cannot remove its items in the app, but they can still add their own. If it is not configured, people choose for themselves.</string>
      <string id="SearchSkipFoldersExplain_ExplainRecommended">Folders that search leaves out, with everything in them, one per line. Environment variables such as %USERPROFILE% work. This list is a default: it is the list people start with, and they can always change it.</string>
      <string id="SearchSkipFolderNames">Never find folders with these names in search</string>
      <string id="SearchSkipFolderNamesExplain_ExplainFixed">Folder names that search leaves out wherever they appear, with everything in them, one per line. Case does not matter. This list is fixed: it is added to people's own rules and applies to everyone it reaches. People cannot remove its items in the app, but they can still add their own. If it is not configured, people choose for themselves.</string>
      <string id="SearchSkipFolderNamesExplain_ExplainRecommended">Folder names that search leaves out wherever they appear, with everything in them, one per line. Case does not matter. This list is a default: it is the list people start with, and they can always change it.</string>
      <string id="SearchSkipFileTypes">Never find these file types in search</string>
      <string id="SearchSkipFileTypesExplain_ExplainFixed">File types that search leaves out, one per line, written as .iso, iso or *.iso. This list is fixed: it is added to people's own rules and applies to everyone it reaches. People cannot remove its items in the app, but they can still add their own. If it is not configured, people choose for themselves.</string>
      <string id="SearchSkipFileTypesExplain_ExplainRecommended">File types that search leaves out, one per line, written as .iso, iso or *.iso. This list is a default: it is the list people start with, and they can always change it.</string>
      <string id="SearchSkipPatterns">Never find paths that match these patterns in search</string>
      <string id="SearchSkipPatternsExplain_ExplainFixed">Regular expressions, one per line, matched against the full path of every file and folder. Case does not matter. A folder's path ends in a backslash here, so \\Payroll\\ leaves out every Payroll folder with everything in it, and \.(key|pem|pfx)$ leaves out keys and certificates. Patterns that are not valid are ignored. This list is fixed: it is added to people's own rules and applies to everyone it reaches. People cannot remove its items in the app, but they can still add their own. If it is not configured, people choose for themselves.</string>
      <string id="SearchSkipPatternsExplain_ExplainRecommended">Regular expressions, one per line, matched against the full path of every file and folder. Case does not matter. A folder's path ends in a backslash here, so \\Payroll\\ leaves out every Payroll folder with everything in it, and \.(key|pem|pfx)$ leaves out keys and certificates. Patterns that are not valid are ignored. This list is a default: it is the list people start with, and they can always change it.</string>
      <string id="AutomaticUpdates">Install updates automatically</string>
      <string id="AutomaticUpdatesExplain_ExplainFixed">Whether new versions install by themselves. Turned off, people can still look for an update and install it from Settings; to stop that too, use "Turn off updates". The task that updates a PC-wide install only reads Computer Configuration, so set it there for those. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="AutomaticUpdatesExplain_ExplainRecommended">Whether new versions install by themselves. The task that updates a PC-wide install only reads Computer Configuration, so set it there for those. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="DefaultView">Default view</string>
      <string id="Details">Details</string>
      <string id="LargeIcons">Large icons</string>
      <string id="Theme">Theme</string>
