<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Daleris</displayName>
  <description>Daleris</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_ANY">Daleris on Windows</string>
      <string id="Daleris">Daleris</string>
      <string id="CatFixed">Fixed settings (cannot be changed by users)</string>
      <string id="CatRecommended">Default settings (users can change them)</string>
      <string id="ExplainFixed">This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="ExplainRecommended">This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="ShowHiddenItems">Show hidden and system items</string>
      <string id="HideDotfiles">Hide dotfiles and dotfolders</string>
      <string id="DefaultSort">Default sort order</string>
      <string id="DefaultSortAscending">Default sort runs from A, oldest or smallest</string>
      <string id="FoldersFirst">Keep folders above files by default</string>
      <string id="DownloadsNewestFirst">Show Downloads newest first, with folders mixed in</string>
      <string id="Sort_name">Name</string>
      <string id="Sort_modified">Date modified</string>
      <string id="Sort_created">Date created</string>
      <string id="Sort_type">Type</string>
      <string id="Sort_extension">Extension</string>
      <string id="Sort_size">Size</string>
      <string id="ShowPreviewPane">Show the preview pane</string>
      <string id="ShowFileExtensions">Show file name extensions</string>
      <string id="CustomTitleBar">Use the Daleris title bar</string>
      <string id="TitleBarLogo">Show the logo in the title bar</string>
      <string id="TitleBarName">Show the app name in the title bar</string>
      <string id="TitleBarSettingsButton">Show the settings button</string>
      <string id="ReopenTabs">Reopen tabs at startup</string>
      <string id="WindowsPropertiesDialog">Use the Windows Properties dialog</string>
      <string id="FolderSizes">Show folder sizes</string>
      <string id="SearchSubfolders">Search subfolders</string>
      <string id="SearchRegex">Treat searches as regular expressions</string>
      <string id="AutomaticUpdates">Install updates automatically</string>
      <string id="AutomaticUpdatesExplain_ExplainFixed">Whether new versions install by themselves. Turned off, people can still look for an update and install it from Settings; to stop that too, use "Turn off updates". The task that updates a PC-wide install only reads Computer Configuration, so set it there for those. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="AutomaticUpdatesExplain_ExplainRecommended">Whether new versions install by themselves. The task that updates a PC-wide install only reads Computer Configuration, so set it there for those. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="DefaultView">Default view</string>
      <string id="Details">Details</string>
      <string id="LargeIcons">Large icons</string>
      <string id="Theme">Theme</string>
      <string id="FollowWindows">Follow Windows</string>
      <string id="Dark">Dark</string>
      <string id="Light">Light</string>
      <string id="AccentColor">Accent colour</string>
      <string id="AccentWindows">Windows accent colour</string>
      <string id="RowHeight">Row height</string>
      <string id="Compact">Compact</string>
      <string id="Normal">Normal</string>
      <string id="Comfortable">Comfortable</string>
      <string id="Accent0">Blue</string>
      <string id="Accent1">Teal</string>
      <string id="Accent2">Purple</string>
      <string id="Accent3">Pink</string>
      <string id="Accent4">Orange</string>
      <string id="Accent5">Green</string>
      <string id="Accent6">Red</string>
      <string id="IconPack">Icon pack</string>
      <string id="IconPackExplain_ExplainFixed">system (Windows icons), flat (Daleris), phosphor, or the name of an icon pack folder. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="IconPackExplain_ExplainRecommended">system (Windows icons), flat (Daleris), phosphor, or the name of an icon pack folder. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="RibbonLeft">Ribbon bar: left side</string>
      <string id="RibbonLeftExplain_ExplainFixed">Items separated by the pipe character. Anything not listed on either side is not shown. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="RibbonLeftExplain_ExplainRecommended">Items separated by the pipe character. Anything not listed on either side is not shown. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="RibbonRight">Ribbon bar: right side</string>
      <string id="RibbonRightExplain_ExplainFixed">Items separated by the pipe character. Anything not listed on either side is not shown. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="RibbonRightExplain_ExplainRecommended">Items separated by the pipe character. Anything not listed on either side is not shown. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="RibbonHidden">Ribbon bar: hidden items</string>
      <string id="RibbonHiddenExplain_ExplainFixed">Items separated by the pipe character. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="RibbonHiddenExplain_ExplainRecommended">Items separated by the pipe character. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="SidebarHiddenSections">Sidebar: hidden sections</string>
      <string id="SidebarHiddenSectionsExplain_ExplainFixed">Any of quick, cloud, pc, network, separated by the pipe character. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="SidebarHiddenSectionsExplain_ExplainRecommended">Any of quick, cloud, pc, network, separated by the pipe character. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="DisableUpdates">Turn off updates</string>
      <string id="DisableUpdatesExplain">Daleris does not look for updates or install them, not even from Settings. Use this if you deploy new versions yourself. The task that updates a PC-wide install only reads Computer Configuration, so set it there for those.</string>
      <string id="LockRibbon">Lock the ribbon bar</string>
      <string id="LockRibbonExplain">The ribbon bar stays as defined by the policies here and cannot be customized.</string>
      <string id="LockSidebar">Lock the sidebar</string>
      <string id="LockSidebarExplain">Sections and places in the sidebar cannot be rearranged, hidden or pinned.</string>
      <string id="LockContextMenu">Lock the right-click menu</string>
      <string id="LockContextMenuExplain">The right-click menu cannot be customized.</string>
      <string id="DisableCustomCommands">Turn off custom commands</string>
      <string id="DisableCustomCommandsExplain">Commands people added themselves are not shown or run, and none can be added.</string>
      <string id="ExplorerOpenFolders">Open folders in Daleris</string>
      <string id="ExplorerOpenFoldersExplain_ExplainFixed">Folders opened from the desktop, Start and most apps open in Daleris. Windows only. Turned off, whatever this switch wrote for a person is removed the next time Daleris runs for them, or sooner if it's running; the launcher and the DLL also obey it right away. Turned on, it only takes effect once Daleris has run for that person. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="ExplorerOpenFoldersExplain_ExplainRecommended">Folders opened from the desktop, Start and most apps open in Daleris. Windows only. It only takes effect once Daleris has run for that person. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="ExplorerWinE">Win + E opens Daleris</string>
      <string id="ExplorerWinEExplain_ExplainFixed">Win + E opens Daleris, through the setting Windows reads for this shortcut. Windows only. Turned off, whatever this switch wrote for a person is removed the next time Daleris runs for them, or sooner if it's running; the launcher and the DLL also obey it right away. Turned on, it only takes effect once Daleris has run for that person. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="ExplorerWinEExplain_ExplainRecommended">Win + E opens Daleris, through the setting Windows reads for this shortcut. Windows only. It only takes effect once Daleris has run for that person. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="ExplorerWinEHook">Win + E opens Daleris through a keyboard hook</string>
      <string id="ExplorerWinEHookExplain_ExplainFixed">A small background program watches for Win + E, for Windows builds that ignore the setting. Runs from sign-in. Windows only. Turned off, whatever this switch wrote for a person is removed the next time Daleris runs for them, or sooner if it's running; the launcher and the DLL also obey it right away. Turned on, it only takes effect once Daleris has run for that person. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="ExplorerWinEHookExplain_ExplainRecommended">A small background program watches for Win + E, for Windows builds that ignore the setting. Runs from sign-in. Windows only. It only takes effect once Daleris has run for that person. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="ExplorerSelectFile">"Show in folder" selects the file</string>
      <string id="ExplorerSelectFileExplain_ExplainFixed">When an app shows a file in its folder through the Windows call for that, the file is selected. Needs folders to open in Daleris. Windows only. Turned off, whatever this switch wrote for a person is removed the next time Daleris runs for them, or sooner if it's running; the launcher and the DLL also obey it right away. Turned on, it only takes effect once Daleris has run for that person. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="ExplorerSelectFileExplain_ExplainRecommended">When an app shows a file in its folder through the Windows call for that, the file is selected. Needs folders to open in Daleris. Windows only. It only takes effect once Daleris has run for that person. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="ExplorerSingleWindow">Open new folders as tabs in the running window</string>
      <string id="ExplorerSingleWindowExplain_ExplainFixed">Folders opened from outside become tabs in the window that is already open. Windows only. Turned off, whatever this switch wrote for a person is removed the next time Daleris runs for them, or sooner if it's running; the launcher and the DLL also obey it right away. Turned on, it only takes effect once Daleris has run for that person. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="ExplorerSingleWindowExplain_ExplainRecommended">Folders opened from outside become tabs in the window that is already open. Windows only. It only takes effect once Daleris has run for that person. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="ExplorerFileDialogs">Open and Save dialogs use Daleris</string>
      <string id="ExplorerFileDialogsExplain_ExplainFixed">Apps that ask Windows for a modern file dialog get Daleris, through a per-user COM registration that loads a DLL into the app when it opens the dialog. Controls the app adds are shown by Daleris too. Controls the app adds are shown by Daleris too. Games, launchers, anti-cheat and security software always get the Windows dialog. Windows only. Turned off, whatever this switch wrote for a person is removed the next time Daleris runs for them, or sooner if it's running; the launcher and the DLL also obey it right away. Turned on, it only takes effect once Daleris has run for that person. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="ExplorerFileDialogsExplain_ExplainRecommended">Apps that ask Windows for a modern file dialog get Daleris, through a per-user COM registration that loads a DLL into the app when it opens the dialog. Games, launchers, anti-cheat and security software always get the Windows dialog. Windows only. It only takes effect once Daleris has run for that person. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="ExplorerDialogJump">Ctrl + G sends a Windows file dialog to the Daleris folder</string>
      <string id="ExplorerDialogJumpExplain_ExplainFixed">While a Windows file dialog is in front, Ctrl + G takes the dialog to the folder Daleris shows, or says that Daleris isn't open. A small background program runs from sign-in for this. Loads nothing into the app. Windows only. Turned off, whatever this switch wrote for a person is removed the next time Daleris runs for them, or sooner if it's running; the launcher and the DLL also obey it right away. Turned on, it only takes effect once Daleris has run for that person. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="ExplorerDialogJumpExplain_ExplainRecommended">While a Windows file dialog is in front, Ctrl + G takes the dialog to the folder Daleris shows, or says that Daleris isn't open. A small background program runs from sign-in for this. Loads nothing into the app. Windows only. It only takes effect once Daleris has run for that person. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="ExplorerDialogExclusions">Apps that keep the Windows file dialog</string>
      <string id="ExplorerDialogExclusionsExplain_ExplainFixed">Program names or folders, separated by the pipe character. !name.exe lets Daleris show a browser's dialogs. Games, anti-cheat and security software are always left alone, whatever this says. Windows only. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="ExplorerDialogExclusionsExplain_ExplainRecommended">Program names or folders, separated by the pipe character. !name.exe lets Daleris show a browser's dialogs. Games, anti-cheat and security software are always left alone, whatever this says. Windows only. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
      <string id="ExplorerDialogLog">Log file dialog decisions</string>
      <string id="ExplorerDialogLogExplain_ExplainFixed">The file dialog DLL writes which apps asked for a dialog and what it decided to %LOCALAPPDATA%\Daleris\logs\file-dialogs.log. Windows only. This value is fixed: it applies to everyone it reaches and is grayed out in the app. If it is not configured, people choose for themselves.</string>
      <string id="ExplorerDialogLogExplain_ExplainRecommended">The file dialog DLL writes which apps asked for a dialog and what it decided to %LOCALAPPDATA%\Daleris\logs\file-dialogs.log. Windows only. This value is a default: it applies until a person picks their own value in the app, and people can always change it.</string>
    </stringTable>
