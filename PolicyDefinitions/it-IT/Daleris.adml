<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Daleris</displayName>
  <description>Daleris</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_ANY">Daleris su Windows</string>
      <string id="Daleris">Daleris</string>
      <string id="CatFixed">Impostazioni fisse (gli utenti non possono cambiarle)</string>
      <string id="CatRecommended">Impostazioni predefinite (gli utenti possono cambiarle)</string>
      <string id="ExplainFixed">Questo valore è fisso: vale per tutti coloro a cui si applica e appare in grigio nell'app. Se non è configurato, ciascuno sceglie da sé.</string>
      <string id="ExplainRecommended">Questo valore è predefinito: vale finché un utente non sceglie un proprio valore nell'app, e gli utenti possono sempre cambiarlo.</string>
      <string id="ShowHiddenItems">Mostra gli elementi nascosti e di sistema</string>
      <string id="HideDotfiles">Nascondi i file e le cartelle che iniziano con un punto (Windows)</string>
      <string id="ExplorerColours">I colori di Esplora file, come impostati in Windows (Windows)</string>
      <string id="ExplorerLines">Le linee di Esplora file tra i riquadri e attorno alla scheda in primo piano (Windows)</string>
      <string id="ExplorerMica">Mica dietro la barra delle schede (Windows 11)</string>
      <string id="ExplorerMicaBar">Con Mica, lasciarla trasparire un po' dalla scheda in primo piano e dalla barra degli indirizzi (Windows 11)</string>
      <string id="OpenNewDrives">Apri una scheda per un'unità quando viene collegata (Windows)</string>
      <string id="StartNewWindow">Avviare di nuovo Daleris apre una nuova finestra (Windows)</string>
      <string id="ShareTransferNotes">Mostra agli altri sulle condivisioni di rete cosa copi, sposti, elimini e hai aperto</string>
