<!-- Built by the Release workflow: wix build -arch x64 -ext WixToolset.UI.wixext -d Version=x.y.z -o name.msi installer\app.wxs
     Silent, for this PC, from an admin prompt: msiexec /i name.msi /qn ALLUSERS=1 [APPLICATIONFOLDER="D:\Apps\Daleris"]
     Silent, for one account, no admin needed: msiexec /i name.msi /qn ALLUSERS=2 MSIINSTALLPERUSER=1 -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Daleris" Manufacturer="MyDrift" Version="$(var.Version)" UpgradeCode="A87468C2-85E0-4FB0-9878-BF6064FC3D7F" Scope="perUserOrMachine">
    <!-- Same version too: a rebuilt release must replace the old one, not install next to it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Daleris is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="app.ico" SourceFile="assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MyDrift-user/daleris" />
    <Property Id="ApplicationFolderName" Value="Daleris" />
    <Property Id="WixAppFolder" Value="WixPerMachineFolder" />
    <!-- The wizard's own defaults are the 32-bit Program Files, and Apps instead of the usual Programs. -->
    <SetProperty Id="WixPerMachineFolder" Value="[ProgramFiles64Folder][ApplicationFolderName]" After="WixSetDefaultPerMachineFolder" Sequence="both" />
    <SetProperty Id="WixPerUserFolder" Value="[LocalAppDataFolder]Programs\[ApplicationFolderName]" After="WixSetDefaultPerUserFolder" Sequence="both" />
    <WixVariable Id="WixUILicenseRtf" Value="target\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="assets\installer-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="assets\installer-dialog.bmp" />
    <!-- Offers this PC or just this account, and works on the folder called APPLICATIONFOLDER below. -->
    <ui:WixUI Id="WixUI_Advanced" />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="APPLICATIONFOLDER" Name="Daleris">
        <Directory Id="UPDATESFOLDER" Name="updates" />
      </Directory>
    </StandardDirectory>
    <Component Directory="APPLICATIONFOLDER">
      <File Source="target\release\daleris.exe" KeyPath="yes">
        <!-- A plain shortcut: an advertised one isn't a real link to the program. The ID matches main.rs.
             It has no Icon of its own, as that's kept in a folder each upgrade deletes, and pins keep pointing there. -->
        <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Daleris" WorkingDirectory="APPLICATIONFOLDER" Advertise="no">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="MyDrift.Daleris" />
        </Shortcut>
      </File>
      <File Source="LICENSE" Name="LICENSE.txt" />
      <File Source="THIRD-PARTY-NOTICES.txt" />
      <RemoveFile Id="RemoveUpdates" Directory="UPDATESFOLDER" Name="*" On="uninstall" />
      <RemoveFolder Id="RemoveUpdatesFolder" Directory="UPDATESFOLDER" On="uninstall" />
    </Component>
    <!-- Marks a PC-wide install. See src/update.rs. -->
    <Component Directory="APPLICATIONFOLDER" Condition="ALLUSERS=1">
      <File Source="installer\machine-install.txt" />
    </Component>
    <!-- For a PC-wide install: installs updates as SYSTEM, so nobody gets an admin prompt. See src/update.rs.
         The task runs this folder's program as SYSTEM, so only admins may change it, wherever it was installed.
         The install fails rather than go on if that can't be done.
         Only on the folder, as files inherit from it: with /T the same command leaves files with no permissions. -->
    <CustomAction Id="LockInstallFolder" Directory="APPLICATIONFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand='"[SystemFolder]icacls.exe" "[APPLICATIONFOLDER]." /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F *S-1-5-32-545:(OI)(CI)RX /C' />
    <CustomAction Id="CreateUpdateTask" Directory="APPLICATIONFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand='"[SystemFolder]schtasks.exe" /Create /F /TN "Daleris Updater" /SC HOURLY /RU SYSTEM /RL HIGHEST /TR "\"[APPLICATIONFOLDER]daleris.exe\" --update-service"' />
    <CustomAction Id="DeleteUpdateTask" Directory="APPLICATIONFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand='"[SystemFolder]schtasks.exe" /Delete /F /TN "Daleris Updater"' />
    <InstallExecuteSequence>
      <Custom Action="DeleteUpdateTask" Before="RemoveFiles" Condition='ALLUSERS=1 AND REMOVE="ALL"' />
      <Custom Action="LockInstallFolder" After="InstallFiles" Condition='ALLUSERS=1 AND NOT REMOVE="ALL"' />
      <Custom Action="CreateUpdateTask" Before="InstallFinalize" Condition='ALLUSERS=1 AND NOT REMOVE="ALL"' />
    </InstallExecuteSequence>
  </Package>
</Wix>
